/* app.wxss - 全局样式 */

/* 页面基础 */
page {
  background-color: #f5f7fa;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

/* 通用工具类 */
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

/* 安全区域 */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom, 0);
}

/* 卡片样式 */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 20rpx 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 按钮基本样式 */
.btn-primary {
  background: linear-gradient(135deg, #7B3FAF, #3DA87E);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 20rpx 60rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
}

.btn-primary:active {
  opacity: 0.8;
}

/* 加载动画 */
.loading-dots {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
}

.loading-dots text {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #7B3FAF;
  animation: dot-bounce 1.4s ease-in-out infinite both;
}

.loading-dots text:nth-child(1) { animation-delay: -0.32s; }
.loading-dots text:nth-child(2) { animation-delay: -0.16s; }
.loading-dots text:nth-child(3) { animation-delay: 0s; }

@keyframes dot-bounce {
  0%, 80%, 100% { transform: scale(0); }
  40% { transform: scale(1); }
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #999;
}

.empty-state text {
  font-size: 28rpx;
  margin-top: 20rpx;
}
