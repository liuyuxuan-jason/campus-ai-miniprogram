/* pages/history/history.wxss */
.page-history {
  min-height: 100vh;
  background: #f5f7fa;
}

/* 筛选栏 */
.filter-bar {
  white-space: nowrap;
  padding: 20rpx 30rpx;
  background: #fff;
  border-bottom: 2rpx solid #f0f0f0;
}

.filter-item {
  display: inline-flex;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  background: #f5f5f5;
  color: #666;
}

.filter-item.active {
  background: #7B3FAF;
  color: #fff;
}

/* 历史列表 */
.history-list {
  padding: 20rpx 30rpx;
}

.history-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.history-item:active {
  opacity: 0.8;
}

.item-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.item-icon {
  font-size: 28rpx;
}

.item-mode {
  font-size: 24rpx;
  color: #7B3FAF;
  background: #f5f0f8;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.item-time {
  font-size: 22rpx;
  color: #999;
  margin-left: auto;
}

.item-title {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
}

.item-msg-count {
  font-size: 22rpx;
  color: #ccc;
}

.item-delete {
  font-size: 24rpx;
  color: #ff4d4f;
  padding: 4rpx 12rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
  color: #999;
}

.empty-state text:first-child {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-hint {
  font-size: 24rpx;
  margin-top: 12rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
}
