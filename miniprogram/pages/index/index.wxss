/* pages/index/index.wxss */
.page-index {
  min-height: 100vh;
  padding-bottom: 20rpx;
}

/* 顶部 */
.header {
  padding: 60rpx 40rpx 40rpx;
  background: linear-gradient(135deg, #5B2C8E 0%, #7B3FAF 40%, #3DA87E 100%);
  color: #fff;
}

.greeting {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.greeting-text {
  font-size: 28rpx;
  opacity: 0.9;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
}

.subtitle {
  font-size: 26rpx;
  opacity: 0.8;
  margin-top: 12rpx;
}

/* 模块区域 */
.module-section {
  margin-top: -20rpx;
  padding: 0 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  padding: 30rpx 0 20rpx;
}

.module-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.module-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  transition: transform 0.2s;
}

.module-card:active {
  transform: scale(0.97);
}

.module-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.icon-emoji {
  font-size: 40rpx;
}

.module-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.module-subs {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.sub-item {
  font-size: 22rpx;
  color: #999;
  background: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

/* 快捷入口 */
.quick-section {
  padding: 0 30rpx;
}

.quick-scroll {
  white-space: nowrap;
  padding-bottom: 20rpx;
}

.quick-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 36rpx;
  margin-right: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.quick-item:active {
  opacity: 0.7;
}

.quick-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.quick-name {
  font-size: 24rpx;
  color: #666;
}
