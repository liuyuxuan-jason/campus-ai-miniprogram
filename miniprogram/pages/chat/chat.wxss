/* pages/chat/chat.wxss */

.page-chat {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f7fa;
}

/* 头部 */
.chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: #fff;
  position: relative;
  z-index: 100;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.mode-icon {
  font-size: 40rpx;
}

.mode-info {
  display: flex;
  flex-direction: column;
}

.mode-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.mode-sub {
  font-size: 22rpx;
  color: #999;
}

.arrow-down {
  font-size: 20rpx;
  color: #999;
  margin-left: 8rpx;
}

.header-right {
  display: flex;
  gap: 20rpx;
}

.btn-new {
  font-size: 36rpx;
  padding: 8rpx;
}

/* 模式选择面板 */
.mode-picker {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
}

.picker-mask {
  position: absolute;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.4);
}

.picker-content {
  position: absolute;
  top: 100rpx;
  left: 20rpx;
  right: 20rpx;
  max-height: 70vh;
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  overflow-y: auto;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  text-align: center;
}

.mode-group {
  margin-bottom: 24rpx;
}

.group-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.group-icon {
  font-size: 28rpx;
}

.group-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.sub-mode-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.sub-mode-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #333;
}

.sub-mode-item:active {
  opacity: 0.7;
}

.sub-check {
  color: #4A90D9;
  font-weight: 600;
}

/* 消息列表 */
.message-list {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.message-container {
  padding: 20rpx 30rpx 30rpx;
}

.message-item {
  margin-bottom: 28rpx;
  max-width: 85%;
}

.message-item.assistant {
  margin-right: auto;
}

.message-item.user {
  margin-left: auto;
}

.msg-content {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
}

.msg-role-tag {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.message-item.assistant .msg-role-tag {
  background: #7B3FAF;
  color: #fff;
}

.message-item.user .msg-content {
  flex-direction: row-reverse;
}

.message-item.user .msg-text {
  background: #4A90D9;
  color: #fff;
  padding: 20rpx 24rpx;
  border-radius: 16rpx 16rpx 4rpx 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-word;
}

.msg-text {
  background: #fff;
  padding: 20rpx 24rpx;
  border-radius: 16rpx 16rpx 16rpx 4rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-word;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.04);
  flex: 1;
  overflow-x: auto;
}

.msg-actions {
  display: flex;
  gap: 16rpx;
  padding: 8rpx 0 0 52rpx;
}

.action-copy {
  font-size: 22rpx;
  color: #999;
  padding: 4rpx 12rpx;
}

/* 思考动画 */
.thinking-animation {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #f0f4ff;
  padding: 20rpx 24rpx;
  border-radius: 16rpx 16rpx 16rpx 4rpx;
  font-size: 28rpx;
  color: #4A90D9;
}

/* 输入区域 */
.input-area {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  padding: 16rpx 30rpx;
  background: #fff;
  border-top: 2rpx solid #f0f0f0;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom, 0));
}

.input-wrapper {
  flex: 1;
  background: #f5f7fa;
  border-radius: 20rpx;
  padding: 12rpx 20rpx;
}

.text-input {
  width: 100%;
  min-height: 60rpx;
  max-height: 200rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.send-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.send-btn.active {
  background: linear-gradient(135deg, #7B3FAF, #3DA87E);
}

.send-btn:active {
  opacity: 0.8;
}

.send-icon {
  color: #fff;
  font-size: 32rpx;
  transform: rotate(-90deg);
}

/* 免责声明 */
.disclaimer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.disclaimer-modal {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  margin: 0 60rpx;
  max-width: 600rpx;
}

.disclaimer-title {
  font-size: 32rpx;
  font-weight: 600;
  display: block;
  text-align: center;
  margin-bottom: 24rpx;
}

.disclaimer-body text {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 12rpx;
}

.disclaimer-btn {
  background: linear-gradient(135deg, #7B3FAF, #3DA87E);
  color: #fff;
  text-align: center;
  padding: 20rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  margin-top: 30rpx;
}

.disclaimer-btn:active {
  opacity: 0.8;
}
