// utils/markdown.wxs - 简单的 Markdown 转 HTML
// 用于 WXS 中，因为 WXS 不支持 ES6

// 主转换函数
function parseMarkdown(text) {
  if (!text) return '';
  
  // 转义 HTML
  var html = text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
  
  // 代码块（先处理，避免被后续规则影响）
  html = html.replace(/```(\w*)\n([\s\S]*?)```/g, function(match, lang, code) {
    return '<pre style="background:#f5f5f5;padding:16rpx;border-radius:8rpx;overflow-x:auto;font-size:24rpx;line-height:1.5;"><code>' + code.replace(/\n/g, '<br/>') + '</code></pre>';
  });
  
  // 行内代码
  html = html.replace(/`([^`]+)`/g, '<code style="background:#f5f5f5;padding:2rpx 8rpx;border-radius:4rpx;font-size:24rpx;">$1</code>');
  
  // 标题
  html = html.replace(/^### (.+)$/gm, '<h3 style="font-size:32rpx;font-weight:600;margin:16rpx 0 8rpx;">$1</h3>');
  html = html.replace(/^## (.+)$/gm, '<h2 style="font-size:34rpx;font-weight:600;margin:20rpx 0 12rpx;">$1</h2>');
  html = html.replace(/^# (.+)$/gm, '<h1 style="font-size:36rpx;font-weight:700;margin:24rpx 0 16rpx;">$1</h1>');
  
  // 粗体和斜体
  html = html.replace(/\*\*\*(.+?)\*\*\*/g, '<strong><em>$1</em></strong>');
  html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  html = html.replace(/\*(.+?)\*/g, '<em>$1</em>');
  
  // 无序列表
  html = html.replace(/^- (.+)$/gm, '<li style="margin:4rpx 0;padding-left:20rpx;">$1</li>');
  html = html.replace(/(<li.*<\/li>\n?)+/g, '<ul style="padding-left:30rpx;margin:8rpx 0;">$&</ul>');
  
  // 有序列表
  html = html.replace(/^\d+\. (.+)$/gm, '<li style="margin:4rpx 0;">$1</li>');
  
  // 水平线
  html = html.replace(/^---$/gm, '<hr style="border:none;border-top:2rpx solid #eee;margin:20rpx 0;">');
  
  // 引用
  html = html.replace(/^> (.+)$/gm, '<blockquote style="border-left:4rpx solid #7B3FAF;padding-left:20rpx;margin:12rpx 0;color:#666;font-size:26rpx;">$1</blockquote>');
  
  // 表格
  html = html.replace(/\|(.+)\|/g, function(match) {
    var cells = match.split('|').filter(function(c) { return c.trim(); });
    var rowHtml = '<tr>';
    for (var i = 0; i < cells.length; i++) {
      rowHtml += '<td style="border:1rpx solid #ddd;padding:8rpx 12rpx;font-size:24rpx;">' + cells[i].trim() + '</td>';
    }
    rowHtml += '</tr>';
    return rowHtml;
  });
  
  // 换行
  html = html.replace(/\n{2,}/g, '<br/><br/>');
  html = html.replace(/\n/g, '<br/>');
  
  return html;
}

module.exports = {
  parseMarkdown: parseMarkdown
};
